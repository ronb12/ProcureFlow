rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function tenantMember(orgId) {
      return request.auth != null && request.auth.token.orgId == orgId;
    }
    function purchasingStaff() {
      return request.auth != null && request.auth.token.role in ['cardholder', 'admin'];
    }
    match /receipts/{orgId}/{requestId}/{fileName} {
      allow read: if tenantMember(orgId);
      allow write: if tenantMember(orgId) && purchasingStaff()
        && request.resource != null && request.resource.size < 10485760
        && request.resource.contentType.matches('(image/.*|application/pdf)');
    }
    match /attachments/{orgId}/{entityType}/{entityId}/{fileName} {
      allow read: if tenantMember(orgId);
      allow write: if tenantMember(orgId) && request.resource != null
        && request.resource.size < 10485760;
    }
    match /exports/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.token.role in ['admin', 'cardholder', 'auditor'];
      allow write: if false; // Cloud Functions generate vetted exports.
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
